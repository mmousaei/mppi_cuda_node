	</node> -->

    <node pkg="mppi_cuda_node" type="mpc_node_contact.py" name="mpc_node" output="screen"> 
        <param name="/odom_topic" value="/odometry"/>
        <param name="/activate_topic" value="/activate_mppi"/>
